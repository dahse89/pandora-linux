#!/usr/bin/env bash
# Run only as the logged-in Wayland user. Select a region, save PNG and copy it.
set -euo pipefail
[[ $(id -u) -ne 0 && ${XDG_SESSION_TYPE:-} == wayland && -n ${WAYLAND_DISPLAY:-} ]] || {
    printf 'Pandora screenshot requires a non-root Wayland session.\n' >&2
    exit 1
}
for command in grim slurp wl-copy; do command -v "$command" > /dev/null; done
# Cancelling region selection makes no file and does not replace the clipboard.
set +e
geometry=$(slurp)
status=$?
set -e
if [[ $status -eq 1 && -z $geometry ]]; then exit 0; fi
[[ $status -eq 0 && -n $geometry ]] || exit 1
directory="${XDG_DATA_HOME:-$HOME/.local/share}/pandora-linux/screenshots"
umask 077
mkdir -p -- "$directory"
file=$(mktemp "$directory/Screenshot-$(date +%Y%m%d-%H%M%S)-XXXXXX.png")
complete=0
trap 'if [[ $complete -eq 0 ]]; then rm -f -- "$file"; fi' EXIT
grim -g "$geometry" "$file"
[[ -s $file ]]
wl-copy --type image/png < "$file"
complete=1
printf '%s\n' "$file"
